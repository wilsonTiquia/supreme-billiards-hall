# Copy to .env and fill in. .env is gitignored and is the ONE place these values live on the
# box: compose.yaml reads it for the containers, deploy/*.sh read it for the backups.

# The public name Caddy serves and gets a certificate for.
SITE_ADDRESS=

# Leave EMPTY on the VPS. For a laptop check set it to `local_certs`: Caddy then signs with
# its own CA instead of asking Let's Encrypt for a name it cannot prove it owns.
CADDY_LOCAL_CERTS=

# The database password. Set once, before the first `docker compose up`; the postgres image
# creates the user with it on the first start and never reads it again.
DB_PASSWORD=

# FIRST BOOT ONLY. Gives the seeded owner account its first password (see
# AdminPasswordBootstrap). Remove this line after logging in and changing the password, then
# `docker compose up -d` again.
SUPREME_BOOTSTRAP_ADMIN_PASSWORD=

# rclone remote for the offsite copy, e.g. `gdrive:SupremeBackups` or `b2:supreme-backups`.
# Configure it with `rclone config` as the deploy user. Empty means the backups exist on ONE
# machine only, and deploy/backup.sh says so on every run.
RCLONE_REMOTE=
