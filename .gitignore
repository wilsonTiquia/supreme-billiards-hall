node_modules/
frontend/dist/
*.tsbuildinfo

### Browser tests ###
# Traces, screenshots and reports from a Playwright run. The browsers themselves live in
# ~/Library/Caches/ms-playwright, outside the project.
frontend/test-results/
frontend/playwright-report/

### OS ###
.DS_Store

### Editors / IDEs ###
# Same shape as the scripts/ exemption above, and the same reasoning. .claude/ is excluded for
# MACHINE STATE — settings.local.json, scheduled_tasks.lock. A SKILL.md is documentation, and
# the next person to run the browser tests needs it.
.claude/*
!.claude/skills/
!.claude/skills/**
.idea/
*.iws
*.iml
*.ipr
.vscode/

